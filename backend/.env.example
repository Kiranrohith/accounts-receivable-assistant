DATABASE_URL=postgresql+asyncpg://ar_assistant:ar_assistant@localhost:5433/ar_assistant
JWT_SECRET=change-me
RAW_FILES_DIR=./data/raw
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
OUR_COMPANY_NAME=
OUR_GSTIN=
GROQ_KEY_1=
GROQ_KEY_2=
GEMINI_KEY=

# --- Sending (Decision 65): one sink per environment ---
# dev / CI: Mailpit, no login, allowlist bypassed (http://localhost:8025 shows what was sent)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=accounts@genworx.local
SMTP_ALLOWED_RECIPIENTS=
SMTP_ALLOWLIST_BYPASS=true
# demo (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER and SMTP_FROM = the AR account,
# SMTP_PASSWORD = a Google app password, SMTP_ALLOWLIST_BYPASS=false, and list every address we may mail:
# SMTP_ALLOWED_RECIPIENTS=anita@client.in,ravi@client.in

# --- Receiving (Gmail API): client from Google Cloud, token from `uv run python scripts/gmail_authorize.py` ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Deployment ---
# The web address(es) the frontend is served from (comma-separated): only these may call the API from a browser.
# CORS_ALLOWED_ORIGINS=https://ar.example.com
# true wherever the site is served over https (the refresh-token cookie); samesite "none" only if the frontend is on another site.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
