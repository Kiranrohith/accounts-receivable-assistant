+def quoted_numbers(text):
+    """Invoice numbers a narration names, as written (INV-1176, INV1176, inv 1157, DN-2001).
+    A bare number such as 'batch 1104' is not one."""
+    import re
+    return [{"invoice_number": m.group(0), "amount": None}
+            for m in re.finditer(r"(?<![A-Za-z0-9])(?:INV|DN)[\s\-]?\d{3,5}(?![0-9])", narration_of(text), re.I)]
+
+
+def narration_of(text):
+    return text or ""
+
+
 def jsonable(o):
     if isinstance(o, Decimal):
         return float(o)
